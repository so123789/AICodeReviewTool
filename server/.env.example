# ── Server Production Environment Template ─────────────────────────────────

# MongoDB Atlas connection string (remember to whitelist 0.0.0.0/0 in Atlas Network Access!)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-code-review?retryWrites=true&w=majority

# JWT signing secret (min 32 random characters for production)
JWT_SECRET=your_long_random_jwt_secret_key_change_in_production_32chars

# Anthropic API Key (starts with sk-ant-api03-...)
ANTHROPIC_API_KEY=sk-ant-api03-your_actual_anthropic_api_key_here

# Anthropic Model ID
ANTHROPIC_MODEL=claude-sonnet-5

# Allowed CORS origins (comma-separated URLs of your deployed frontend, e.g. Render, Vercel, Netlify)
CORS_ORIGINS=http://localhost:5173,https://your-app.onrender.com,https://your-app.vercel.app

# Optional server configuration
PORT=5000
NODE_ENV=production
MAX_CODE_LENGTH=20000
